# Local development. Production: https://binzomah.net
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the contact form posts. The provider must accept FormData and return
# application/json with explicit { "ok": true } (or { "success": true } below).
# Use an approved HTTPS endpoint; verify its CORS and spam/rate limits first.
# Public by nature — this is a browser destination, never a credential.
#
# Leave it unset and the form is display-only: it still renders, a short
# note says it is not connected yet, and the send button is disabled, so
# nothing is ever posted into nowhere.
#
# The site is statically generated, so the value is baked in when
# `npm run generate` runs. Set it in .env locally; for GitHub Pages set the
# repository variable CONTACT_FORM_ENDPOINT, which the deploy workflow
# passes to the generate step.
NUXT_PUBLIC_CONTACT_FORM_ENDPOINT=
NUXT_PUBLIC_CONTACT_FORM_SUCCESS_FIELD=ok

# Dashboard: opt-in Node build; see layers/admin/README.md.
# npm run build:admin enables it at build time. Do not enable for generate.
# NUXT_ADMIN_ENABLED=true
# Use a private persistent absolute path on the Node host:
# NUXT_ADMIN_DB_PATH=/var/lib/binzomah/admin.sqlite
# Exact browser origin, required behind a TLS reverse proxy:
# NUXT_ADMIN_ORIGIN=https://binzomah.net
# NUXT_ADMIN_SECURE_COOKIES=true
# Use false only for a local HTTP production-build preview.
