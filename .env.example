# Local development. Production: https://binzomah.net
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the contact form posts. Any service that accepts a plain form POST
# works (Formspree, Formspark, Basin, Web3Forms, ...). Public by nature —
# it is the URL a browser posts to, not a credential.
#
# Leave it unset and the contact page shows its phone and email details
# with a short note in the form's place, rather than a form that goes
# nowhere. Set it in .env locally, and as an environment variable on the
# host for production.
NUXT_PUBLIC_CONTACT_FORM_ENDPOINT=
